{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "types": ["node"],

    "rootDir": ".",
    "outDir": "dist",

    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,

    "sourceMap": true
  },

  "include": [
    "src",
    "prisma.config.ts"
  ]
}